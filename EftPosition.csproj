<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>WinExe</OutputType><RootNamespace>EftPosition</RootNamespace><AssemblyName>EftPosition</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <OutputPath>bin\$(Configuration)\</OutputPath><Optimize>true</Optimize><ApplicationManifest>src\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/><Reference Include="System.Web.Extensions"/>
    <Compile Include="src\Core.cs"/><Compile Include="src\FolderMonitor.cs"/><Compile Include="src\MapCanvas.cs"/><Compile Include="src\MainForm.cs"/><Compile Include="src\Program.cs"/>
    <Compile Include="src\Maps.cs"/><Compile Include="src\MapAssets.cs"/>
    <Compile Include="src\AutoNavigation.cs"/><Compile Include="src\VectorMap.cs"/><Compile Include="src\TileMap.cs"/>
    <Compile Include="src\SvgPathCanonicalizer.cs"/>
    <Compile Include="src\MapViewport.cs"/><Compile Include="src\RasterImage.cs"/>
    <Compile Include="src\MiniMapRenderer.cs"/><Compile Include="src\MiniMapOverlay.cs"/><Compile Include="src\OverlayHotkeys.cs"/><Compile Include="src\GameMapMonitor.cs"/>
    <Compile Include="src\UiText.cs"/><Compile Include="src\UiTheme.cs"/><Compile Include="src\ThemedForm.cs"/><Compile Include="src\MapBackdrop.cs"/><Compile Include="src\SettingsForm.cs"/>
    <Compile Include="src\MapMarkers.cs"/><Compile Include="src\MarkerPanel.cs"/>
    <Compile Include="src\AssemblyInfo.cs"/><Compile Include="src\AppPreferences.cs"/><Compile Include="src\ScreenshotCleaner.cs"/><Compile Include="src\MarkerArtwork.cs"/>
    <Reference Include="SharpVectors.Core"><HintPath>lib\SharpVectors.Core.dll</HintPath></Reference>
    <Reference Include="SharpVectors.Dom"><HintPath>lib\SharpVectors.Dom.dll</HintPath></Reference>
    <Reference Include="SharpVectors.Css"><HintPath>lib\SharpVectors.Css.dll</HintPath></Reference>
    <Reference Include="SharpVectors.Model"><HintPath>lib\SharpVectors.Model.dll</HintPath></Reference>
    <Reference Include="SharpVectors.Rendering.Gdi"><HintPath>lib\SharpVectors.Rendering.Gdi.dll</HintPath></Reference>
    <None Include="EftPosition.exe.config"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <Content Include="assets\maps.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="assets\maps\*.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="assets\vectors\*.svg"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="assets\maps.upstream.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="assets\markers.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="assets\markers.source.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="assets\tarkov-background.jpg"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="assets\tarkov-cyberpunk-background.jpg"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="assets\app.ico"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>


